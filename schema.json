{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/metro-app/schema.json",
  "title": "Transit City Data",
  "description": "One file per city. Describes transport lines, stations, accessibility, and a GTFS-style schedule. transportType is kept generic on purpose so bus/tram/BRT can be added later without changing this schema.",
  "type": "object",
  "required": ["meta", "lines", "stations", "calendar", "trips", "stopTimes"],
  "properties": {

    "meta": {
      "type": "object",
      "required": ["country", "city", "dataVersion", "lastUpdated", "source"],
      "properties": {
        "country": { "type": "string", "description": "ISO 3166-1 alpha-2 code, e.g. 'IR'" },
        "city": { "type": "string", "description": "Machine-readable slug, e.g. 'tehran'" },
        "dataVersion": { "type": "string", "description": "Semver-like string, bumped on every published change, e.g. '1.4.0'" },
        "lastUpdated": { "type": "string", "format": "date", "description": "YYYY-MM-DD, date this file's data was last verified/edited" },
        "source": {
          "type": "array",
          "description": "Where this data came from, for traceability and re-verification",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["osm", "official_gtfs", "official_other", "community_survey", "other"] },
              "url": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },

    "localizedText": {
      "type": "object",
      "description": "Map of locale code to text, e.g. { \"fa\": \"تجریش\", \"en\": \"Tajrish\" }. At minimum include the local-language name.",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    },

    "lines": {
      "type": "array",
      "items": { "$ref": "#/definitions/line" }
    },

    "stations": {
      "type": "array",
      "items": { "$ref": "#/definitions/station" }
    },

    "calendar": {
      "type": "array",
      "description": "Service patterns, GTFS-style — which days a given service pattern runs.",
      "items": { "$ref": "#/definitions/calendarEntry" }
    },

    "trips": {
      "type": "array",
      "description": "One trip = one train's run along a line in one direction, tied to a service pattern.",
      "items": { "$ref": "#/definitions/trip" }
    },

    "stopTimes": {
      "type": "array",
      "description": "Per-station arrival/departure times for each trip — this is the full GTFS-style timetable.",
      "items": { "$ref": "#/definitions/stopTime" }
    }
  },

  "definitions": {

    "line": {
      "type": "object",
      "required": ["id", "name", "color", "transportType", "stationIds"],
      "properties": {
        "id": { "type": "string", "description": "Stable unique id, e.g. 'tehran-line-1'" },
        "name": { "$ref": "#/properties/localizedText" },
        "shortName": { "type": "string", "description": "Short label for badges, e.g. '1' or 'A'" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "description": "Official line color, hex" },
        "transportType": {
          "type": "string",
          "description": "Generic on purpose for future expansion beyond metro.",
          "enum": ["metro", "bus", "tram", "brt", "commuter_rail", "other"]
        },
        "stationIds": {
          "type": "array",
          "description": "Ordered station ids, in one canonical direction (direction 0). Used for drawing the line and computing stop sequence.",
          "items": { "type": "string" }
        },
        "operatingHours": {
          "type": "object",
          "description": "General-purpose display info, not the authoritative schedule (that's stopTimes).",
          "properties": {
            "firstTrain": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            "lastTrain": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
          }
        }
      }
    },

    "station": {
      "type": "object",
      "required": ["id", "name", "lat", "lng", "lineIds"],
      "properties": {
        "id": { "type": "string" },
        "name": { "$ref": "#/properties/localizedText" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "lineIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "All lines serving this station — more than one entry means it's an interchange station."
        },
        "accessibility": {
          "type": "object",
          "description": "Accessibility features at this station.",
          "properties": {
            "elevator": { "type": "boolean" },
            "ramp": { "type": "boolean" },
            "tactilePaving": { "type": "boolean" },
            "accessibleRestroom": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "entrances": {
          "type": "array",
          "description": "Optional — individual entrance/exit points, useful for large stations.",
          "items": {
            "type": "object",
            "required": ["lat", "lng"],
            "properties": {
              "name": { "$ref": "#/properties/localizedText" },
              "lat": { "type": "number" },
              "lng": { "type": "number" },
              "wheelchairAccessible": { "type": "boolean" }
            }
          }
        }
      }
    },

    "calendarEntry": {
      "type": "object",
      "required": ["id", "daysOfWeek"],
      "properties": {
        "id": { "type": "string", "description": "e.g. 'weekday', 'friday', 'holiday'" },
        "daysOfWeek": {
          "type": "array",
          "items": { "type": "string", "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
        },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "exceptions": {
          "type": "array",
          "description": "Specific added/removed dates (holidays, etc.)",
          "items": {
            "type": "object",
            "required": ["date", "type"],
            "properties": {
              "date": { "type": "string", "format": "date" },
              "type": { "type": "string", "enum": ["added", "removed"] }
            }
          }
        }
      }
    },

    "trip": {
      "type": "object",
      "required": ["id", "lineId", "direction", "calendarId"],
      "properties": {
        "id": { "type": "string" },
        "lineId": { "type": "string" },
        "direction": { "type": "integer", "enum": [0, 1], "description": "0 = matches line.stationIds order, 1 = reverse" },
        "calendarId": { "type": "string", "description": "References a calendar.id" }
      }
    },

    "stopTime": {
      "type": "object",
      "required": ["tripId", "stationId", "arrivalTime", "stopSequence"],
      "properties": {
        "tripId": { "type": "string" },
        "stationId": { "type": "string" },
        "arrivalTime": { "type": "string", "pattern": "^([0-1][0-9]|2[0-4]):[0-5][0-9]:[0-5][0-9]$", "description": "HH:MM:SS, can exceed 24:00:00 for past-midnight trips, GTFS-style" },
        "departureTime": { "type": "string", "pattern": "^([0-1][0-9]|2[0-4]):[0-5][0-9]:[0-5][0-9]$" },
        "stopSequence": { "type": "integer", "minimum": 0, "description": "Order of this stop within the trip" }
      }
    }
  }
}
